---
import Info from "../components/Info.astro";
import { Image } from 'astro:assets';
import mainImage from '../images/beryl sugardrift valentines king astro.png';
import polyam from '../images/polyam.gif';
---
<Info title="Beryl's Polyamory">
    <Fragment slot="image">
        <Image class="main" src={mainImage} alt="Beryl the Bunny being kissed by both King the Lynx, and Astrognash the Otter" style="width:300px; height:auto;"/>
        <div class="credit">Art by <a class="external" href="https://sugardrift.carrd.co/">Sugardrift</a></div>
    </Fragment>
    <Fragment slot="blinkies">
        <Image class="blinky" src={polyam} alt="POLYAMOROUS"/>
    </Fragment>
    <p>
        I have <strong>2</strong> wonderful partners who I love very much.
        <a class="external" href="https://bsky.app/profile/wearbolf.top"><strong>RAYNE</strong></a> is my boyfriend, and we have been dating for <strong>TWO</strong> years!
        <strong>ASTROGNASH</strong> is my husband, we have been together for <strong>TWELVE</strong> years, and <strong>MARRIED</strong> for <strong>SEVEN</strong>!
    </p>
</Info>