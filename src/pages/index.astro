---
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import mainImage from '../images/beryl puppy badge.jpeg';
import teaBooksBlinky from '../images/tea_books.gif';
import jetBlinky from '../images/jet_squelcher.gif';
import teaBlinky from '../images/tea_love.gif';
import antiAiBlinky from '../images/anti ai.gif';
import "../css/style.css"
import "../css/bio-style.css"
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Beryl</title>
    <link rel="icon" href="../../public/favicon.svg" sizes="any" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather&display=swap" rel="stylesheet">
	</head>
	<body>
    <div id="container">
        <div id="icon">
          <Image src={mainImage} alt="Beryl the Fisher's head over their name"/>
        </div>
        <div id="bio">
          <div class="credit">Art by <a href="https://www.parttimepuppy.com/">Part Time Puppy</a></div>
          <p>
            Hi, I'm <strong>BERYL</strong>, welcome to my little corner of the internet!
          </p>
          <p>
            I'm <a href="queer.html"><strong>AGENDER</strong></a>, <a href="/queer/"><strong>PANSEXUAL</strong></a>, and my pronouns are <strong>IT/THEM</strong>. I am <a href="/poly/"><strong>POLYAMOROUS</strong></a> and have <strong>2</strong> amazing partners.
            I'm also both <a href="/plurality/"><strong>PLURAL</strong></a> and a <a href="/therian/"><strong>THERIAN</strong></a>.
          </p>
          <p>
            I love listening to <strong>FURRY MUSIC</strong> on <strong>CASSETTE</strong>, drinking all sorts of <strong>TEA</strong>, playing <strong>VIDEOGAMES</strong>, and making <strong>ANDROID APPS</strong>.
          </p>
        </div>
        <div id="blinkies">
          <Image class="blinky" src={teaBooksBlinky} alt="tea and books"/>
          <Image class="blinky" src={jetBlinky} alt="Jet Squelcher"/>
          <Image class="blinky" src={teaBlinky} alt="I love drinking tea!"/>
          <Image class="blinky" src={antiAiBlinky} alt="This is an Anti-Ai site"/>
        </div>
      
    </div>
    <Footer></Footer>
  </body>
</html>
